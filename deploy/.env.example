# Copy to deploy/.env and fill in. deploy/.env is git-ignored — never commit it.

# --- Where the API is reached (Caddy gets HTTPS for this automatically) ---
# Use a real subdomain once you have a domain (point it at the server IP):
#   API_DOMAIN=api.yourdomain.com
# Or, before you own a domain, use the server's IP via sslip.io (dashes, not dots):
#   API_DOMAIN=203-0-113-5.sslip.io
API_DOMAIN=

# --- Database (Postgres runs in a container on this box) ---
POSTGRES_USER=neura
POSTGRES_PASSWORD=change-this-to-a-long-random-string
POSTGRES_DB=neura

# --- Auth secret (long random string) ---
JWT_SECRET=change-this-to-a-long-random-string

# --- LLM (DeepSeek by default) ---
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Frontend origin (your Vercel URL) for CORS + email links ---
CORS_ORIGINS=https://ai-research-assisstant.vercel.app
FRONTEND_URL=https://ai-research-assisstant.vercel.app

# --- Payments (EasyKash) — leave blank until live ---
EASYKASH_API_KEY=
EASYKASH_WEBHOOK_SECRET=

# --- Email (SMTP) — leave blank to just log verification links ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Ops ---
ADMIN_TOKEN=
