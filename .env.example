# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM (any OpenAI-compatible provider) ---
# Default is Google Gemini. Create a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Other providers (just change the three values above):
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1            LLM_MODEL=llama3.1   (LLM_API_KEY=ollama)

# --- External research integrations (optional at this stage) ---
COPYLEAKS_API_KEY=
PUBMED_API_KEY=
UNPAYWALL_EMAIL=

# --- Sandbox ---
# Docker image used to execute generated Python/R scripts in isolation
SANDBOX_IMAGE=research-assistant-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
# DEV ONLY: run scripts in a plain subprocess when Docker is absent (no isolation).
SANDBOX_ALLOW_SUBPROCESS_FALLBACK=false

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
VERIFY_TOKEN_MINUTES=1440
RESET_TOKEN_MINUTES=30

# --- Email (SMTP). Leave SMTP_HOST empty in dev to log links instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Base URL of the deployed frontend, used to build verify/reset links.
FRONTEND_URL=http://localhost:8000/ui

# --- Payments (EasyKash) ---
EASYKASH_API_KEY=
EASYKASH_WEBHOOK_SECRET=
EASYKASH_BASE_URL=https://back.easykash.net/api/v1
EASYKASH_SIGNATURE_HEADER=X-EasyKash-Signature
# Fees: 3.5% commission + 5 EGP surcharge. If true, the customer is billed enough
# that you net your quoted price (or use the dashboard "pass fees to customer").
EASYKASH_COMMISSION_RATE=0.035
EASYKASH_FLAT_FEE_EGP=5
EASYKASH_PASS_FEES_TO_CUSTOMER=true

# --- Security ---
RATE_LIMIT_ENABLED=true
MAX_PROTOCOL_CHARS=20000
MAX_UPLOAD_MB=25
MAX_SUMMARY_COLUMNS=60
# Set to enable the /admin endpoints; send it in the X-Admin-Token header.
ADMIN_TOKEN=

# --- Storage ---
DATA_DIR=data

# --- Database ---
# SQLite by default (zero setup). For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/research_assistant
DATABASE_URL=sqlite:///./data/app.db

# --- CORS ---
# Comma-separated frontend origins, or * for any.
CORS_ORIGINS=*
