# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Kimi / Moonshot (OpenAI-compatible) ---
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# --- External research integrations (optional at this stage) ---
COPYLEAKS_API_KEY=
PUBMED_API_KEY=
UNPAYWALL_EMAIL=

# --- Sandbox ---
# Docker image used to execute generated Python/R scripts in isolation
SANDBOX_IMAGE=research-assistant-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
# DEV ONLY: run scripts in a plain subprocess when Docker is absent (no isolation).
SANDBOX_ALLOW_SUBPROCESS_FALLBACK=false

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Payments (EasyKash) ---
EASYKASH_API_KEY=
EASYKASH_WEBHOOK_SECRET=
EASYKASH_BASE_URL=https://back.easykash.net/api/v1
EASYKASH_SIGNATURE_HEADER=X-EasyKash-Signature
# Fees: 3.5% commission + 5 EGP surcharge. If true, the customer is billed enough
# that you net your quoted price (or use the dashboard "pass fees to customer").
EASYKASH_COMMISSION_RATE=0.035
EASYKASH_FLAT_FEE_EGP=5
EASYKASH_PASS_FEES_TO_CUSTOMER=true

# --- Security ---
RATE_LIMIT_ENABLED=true
MAX_PROTOCOL_CHARS=20000

# --- Storage ---
DATA_DIR=data

# --- Database ---
# SQLite by default (zero setup). For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/research_assistant
DATABASE_URL=sqlite:///./data/app.db

# --- CORS ---
# Comma-separated frontend origins, or * for any.
CORS_ORIGINS=*
