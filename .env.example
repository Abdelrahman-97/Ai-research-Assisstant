# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Kimi / Moonshot (OpenAI-compatible) ---
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# --- External research integrations (optional at this stage) ---
COPYLEAKS_API_KEY=
PUBMED_API_KEY=
UNPAYWALL_EMAIL=

# --- Sandbox ---
# Docker image used to execute generated Python/R scripts in isolation
SANDBOX_IMAGE=research-assistant-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
